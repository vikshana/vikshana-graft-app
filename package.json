{
  "name": "graft",
  "version": "0.1.2-electramet.198",
  "scripts": {
    "bump:deploy": "node scripts/bump-deploy.mjs",
    "provision:orgs": "node scripts/provision-graft-orgs.mjs",
    "provision:sync": "bash scripts/sync-provisioning.sh",
    "provision:timer": "bash scripts/install-auto-provision.sh",
    "deploy": "bash scripts/deploy-electramet.sh",
    "deploy:rsync": "bash scripts/deploy-electramet.sh --no-bump --rsync-only",
    "deploy:frontend": "bash scripts/deploy-electramet.sh --frontend-only",
    "deploy:clean": "bash scripts/deploy-electramet.sh --clean",
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch --onlyChanged",
    "test:ci": "jest --watchAll=false --passWithNoTests --maxWorkers 4",
    "test:regression": "jest --watchAll=false --runInBand --forceExit --testPathPattern=graftFailureRegression",
    "test:regression:e2e": "GRAFANA_URL=${GRAFANA_URL:-https://35.175.68.13} GRAFANA_E2E=1 playwright test tests/graftRegression.spec.ts --project=graft-regression",
    "test:regression:e2e:mutating": "GRAFANA_URL=${GRAFANA_URL:-https://35.175.68.13} GRAFANA_E2E=1 GRAFANA_E2E_MUTATING=1 playwright test tests/graftRegression.spec.ts --project=graft-regression",
    "test:regression:e2e:login": "playwright codegen \"${GRAFANA_URL:-https://35.175.68.13}\" --save-storage=playwright/.auth/admin.json --ignore-https-errors",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Vikshana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.0.1",
    "@grafana/tsconfig": "^2.0.1",
    "@playwright/test": "^1.52.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "1.13.20",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "copy-webpack-plugin": "^11.0.0",
